    "1 month" => "M"
    => timeframe.period

string orderBlockTimeframeLabel = switch orderBlockTimeframeInput
    "3 minutes" => "3m"
    "5 minutes" => "5m"
    "15 minutes" => "15m"
    "1 hour" => "1H"
    "4 hours" => "4H"
    "1 day" => "1D"
    "1 week" => "1W"
    "1 month" => "1M"
    => "Chart"

structureLineStyle = switch structureLineStyleInput
    "Solid" => line.style_solid
    "Dotted" => line.style_dotted
    => line.style_dashed

var array<line> structureLines = array.new<line>()
var array<label> structureLabels = array.new<label>()
var array<line> equalLevelLines = array.new<line>()
var array<label> equalLevelLabels = array.new<label>()
var array<box> orderBlockBoxes = array.new<box>()
var array<int> orderBlockCreationBars = array.new<int>()

drawStructureLine(int startBar, float level, string structureText, color structureColor) =>
    int labelBar = startBar + int(math.round((bar_index - startBar) / 2.0))
    line newStructureLine = line.new(startBar, level, bar_index, level, xloc = xloc.bar_index, color = structureColor, style = structureLineStyle, width = structureLineWidth)
    label newStructureLabel = label.new(labelBar, level, showStructureLabels ? structureText : "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = structureColor, size = size.tiny)
    array.push(structureLines, newStructureLine)
    array.push(structureLabels, newStructureLabel)
    if array.size(structureLines) > maxStructureBreaks
        line.delete(array.shift(structureLines))
        label.delete(array.shift(structureLabels))

drawEqualLevel(int startBar, int endBar, float level, string levelText, color levelColor) =>
    line newEqualLevelLine = line.new(startBar, level, endBar, level, xloc = xloc.bar_index, color = levelColor, style = line.style_dotted, width = 1)
    label newEqualLevelLabel = label.new(endBar, level, levelText, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = levelColor, size = size.tiny)
    array.push(equalLevelLines, newEqualLevelLine)
    array.push(equalLevelLabels, newEqualLevelLabel)
    if array.size(equalLevelLines) > maxEqualLevels
        line.delete(array.shift(equalLevelLines))
        label.delete(array.shift(equalLevelLabels))

drawOrderBlock(int startTime, float zoneHigh, float zoneLow, color zoneColor, string zoneLabel) =>
    box newOrderBlock = box.new(left = startTime, top = zoneHigh, right = time, bottom = zoneLow, xloc = xloc.bar_time, extend = extend.right, border_color = zoneColor, bgcolor = color.new(zoneColor, 86), text = zoneLabel, text_color = zoneColor, text_halign = text.align_left, text_valign = text.align_top, text_size = size.tiny)
    array.push(orderBlockBoxes, newOrderBlock)
    array.push(orderBlockCreationBars, bar_index)
    if array.size(orderBlockBoxes) > maxOrderBlocks
        box.delete(array.shift(orderBlockBoxes))
        array.shift(orderBlockCreationBars)

removeMitigatedOrderBlocks() =>
    if array.size(orderBlockBoxes) > 0
        for index = array.size(orderBlockBoxes) - 1 to 0
            box activeOrderBlock = array.get(orderBlockBoxes, index)
            int creationBar = array.get(orderBlockCreationBars, index)
            bool zoneTouched = bar_index > creationBar and low <= box.get_top(activeOrderBlock) and high >= box.get_bottom(activeOrderBlock)
            if zoneTouched
                box.delete(activeOrderBlock)
                array.remove(orderBlockBoxes, index)
                array.remove(orderBlockCreationBars, index)

getOrderBlockData() =>
    float localAtr = ta.atr(14)
    float localAverageVolume = ta.sma(volume, smcVolumeLength)
    float localPivotHigh = ta.pivothigh(high, structureLength, structureLength)
    float localPivotLow = ta.pivotlow(low, structureLength, structureLength)
    var float localPreviousHigh = na
    var float localPreviousLow = na
    var bool localHighBroken = false
    var bool localLowBroken = false
    var float localLastBearishHigh = na
    var float localLastBearishLow = na
    var int localLastBearishTime = na
    var float localLastBullishHigh = na
    var float localLastBullishLow = na
    var int localLastBullishTime = na

    if not na(localPivotHigh)
        localPreviousHigh := localPivotHigh
        localHighBroken := false
    if not na(localPivotLow)
        localPreviousLow := localPivotLow
        localLowBroken := false
    if close < open
        localLastBearishHigh := high
        localLastBearishLow := low
        localLastBearishTime := time
    if close > open
        localLastBullishHigh := high
        localLastBullishLow := low
        localLastBullishTime := time

    float localRange = high - low
    float localBody = math.abs(close - open)
    bool localBullishStrong = localRange > 0 and localBody >= localRange * smcBodyPercent / 100 and close > open
    bool localBearishStrong = localRange > 0 and localBody >= localRange * smcBodyPercent / 100 and close < open
    bool localVolumeConfirmed = volume >= localAverageVolume * smcVolumeMultiplier
    // request.security() supplies completed higher-timeframe bars with the
    // lookahead setting below, so do not use barstate.isconfirmed here.
    bool localBullishBreak = not na(localPreviousHigh) and not localHighBroken and close > localPreviousHigh + localAtr * breakoutATR and localBullishStrong and close - open >= localAtr * smcDisplacementATR and localVolumeConfirmed
    bool localBearishBreak = not na(localPreviousLow) and not localLowBroken and close < localPreviousLow - localAtr * breakoutATR and localBearishStrong and open - close >= localAtr * smcDisplacementATR and localVolumeConfirmed
    if localBullishBreak
        localHighBroken := true
    if localBearishBreak
        localLowBroken := true

    [localBullishBreak, localBearishBreak, localLastBearishHigh, localLastBearishLow, localLastBearishTime, localLastBullishHigh, localLastBullishLow, localLastBullishTime]

[selectedTFBullishOrderBlock, selectedTFBearishOrderBlock, selectedTFBullishZoneHigh, selectedTFBullishZoneLow, selectedTFBullishZoneTime, selectedTFBearishZoneHigh, selectedTFBearishZoneLow, selectedTFBearishZoneTime] = request.security(syminfo.tickerid, orderBlockTimeframe, getOrderBlockData(), gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off)

// Confirmed pivot levels replace the rolling-high/low calculation. Each level
// is marked as consumed once it produces a structure break, preventing a BOS
// label on every successive new high or low.
float confirmedStructureHigh = ta.pivothigh(high, structureLength, structureLength)
float confirmedStructureLow = ta.pivotlow(low, structureLength, structureLength)

var float previousHigh = na
var float previousLow = na
var int previousHighBar = na
var int previousLowBar = na
var float equalHighReference = na
var float equalLowReference = na
var int equalHighReferenceBar = na
var int equalLowReferenceBar = na
var bool structureHighBroken = false
var bool structureLowBroken = false
var float lastBearishOrderBlockHigh = na
var float lastBearishOrderBlockLow = na
var int lastBearishOrderBlockTime = na
var float lastBullishOrderBlockHigh = na
var float lastBullishOrderBlockLow = na
var int lastBullishOrderBlockTime = na

if not na(confirmedStructureHigh)
    int confirmedHighBar = bar_index - structureLength
    float equalLevelTolerance = nz(smcAtr[structureLength], smcAtr) * equalLevelToleranceATR
    if showEqualLevels and not na(equalHighReference) and math.abs(confirmedStructureHigh - equalHighReference) <= equalLevelTolerance
        drawEqualLevel(equalHighReferenceBar, confirmedHighBar, (confirmedStructureHigh + equalHighReference) / 2.0, "EQH", eqhColor)
    equalHighReference := confirmedStructureHigh
    equalHighReferenceBar := confirmedHighBar
    previousHigh := confirmedStructureHigh
    previousHighBar := confirmedHighBar
    structureHighBroken := false

if not na(confirmedStructureLow)
    int confirmedLowBar = bar_index - structureLength
    float equalLevelTolerance = nz(smcAtr[structureLength], smcAtr) * equalLevelToleranceATR
    if showEqualLevels and not na(equalLowReference) and math.abs(confirmedStructureLow - equalLowReference) <= equalLevelTolerance
        drawEqualLevel(equalLowReferenceBar, confirmedLowBar, (confirmedStructureLow + equalLowReference) / 2.0, "EQL", eqlColor)
    equalLowReference := confirmedStructureLow
    equalLowReferenceBar := confirmedLowBar
    previousLow := confirmedStructureLow
    previousLowBar := confirmedLowBar
    structureLowBroken := false

// A bullish break uses the latest bearish candle as a potential demand zone;
// a bearish break uses the latest bullish candle as a potential supply zone.
if close < open
    lastBearishOrderBlockHigh := high
    lastBearishOrderBlockLow := low
    lastBearishOrderBlockTime := time

if close > open
    lastBullishOrderBlockHigh := high
    lastBullishOrderBlockLow := low
    lastBullishOrderBlockTime := time

breakBuffer = smcAtr * breakoutATR
buyStructure = not na(previousHigh) and not structureHighBroken and close > previousHigh + breakBuffer
sellStructure = not na(previousLow) and not structureLowBroken and close < previousLow - breakBuffer

bullishDisplacement = close - open >= smcAtr * smcDisplacementATR
bearishDisplacement = open - close >= smcAtr * smcDisplacementATR
smcVolumeConfirmed = volume >= smcAverageVolume * smcVolumeMultiplier

//====================================================
// BREAK OF STRUCTURE
//====================================================

bullishStructureBreak =
     buyStructure and
     smcBullishStrong and
     bullishDisplacement and
     smcVolumeConfirmed and
     barstate.isconfirmed

bearishStructureBreak =
     sellStructure and
     smcBearishStrong and
     bearishDisplacement and
     smcVolumeConfirmed and
     barstate.isconfirmed

//====================================================
// CHANGE OF CHARACTER
//====================================================

var string marketStructure = "NONE"

bool chochBull = bullishStructureBreak and marketStructure == "BEAR"
bool chochBear = bearishStructureBreak and marketStructure == "BULL"

// A continuation is BOS. A valid break against the prior structure is CHoCH,
// so the same event is never labelled as both.
bullishBOS = bullishStructureBreak and not chochBull
bearishBOS = bearishStructureBreak and not chochBear

if bearishStructureBreak
    structureLowBroken := true
    marketStructure := "BEAR"

if bullishStructureBreak
    structureHighBroken := true
    marketStructure := "BULL"

if showStructureLines
    if bullishBOS and showBOSLines
        drawStructureLine(previousHighBar, previousHigh, "BOS", bosBullColor)
    if bearishBOS and showBOSLines
        drawStructureLine(previousLowBar, previousLow, "BOS", bosBearColor)
    if chochBull and showCHoCHLines
        drawStructureLine(previousHighBar, previousHigh, "CHoCH", chochBullColor)
    if chochBear and showCHoCHLines
        drawStructureLine(previousLowBar, previousLow, "CHoCH", chochBearColor)

if showOrderBlocks
    // Active order blocks stay extended into later sessions and disappear as
    // soon as price trades back into their range (mitigation/completion).
    removeMitigatedOrderBlocks()
    if orderBlockTimeframeInput == "Chart"
        if bullishStructureBreak and showBullishOrderBlocks and not na(lastBearishOrderBlockTime)
            drawOrderBlock(lastBearishOrderBlockTime, lastBearishOrderBlockHigh, lastBearishOrderBlockLow, bullishOrderBlockColor, "Demand OB • " + orderBlockTimeframeLabel)
        if bearishStructureBreak and showBearishOrderBlocks and not na(lastBullishOrderBlockTime)
            drawOrderBlock(lastBullishOrderBlockTime, lastBullishOrderBlockHigh, lastBullishOrderBlockLow, bearishOrderBlockColor, "Supply OB • " + orderBlockTimeframeLabel)
    else
        if selectedTFBullishOrderBlock and showBullishOrderBlocks and not na(selectedTFBullishZoneTime)
            drawOrderBlock(selectedTFBullishZoneTime, selectedTFBullishZoneHigh, selectedTFBullishZoneLow, bullishOrderBlockColor, "Demand OB • " + orderBlockTimeframeLabel)
        if selectedTFBearishOrderBlock and showBearishOrderBlocks and not na(selectedTFBearishZoneTime)
            drawOrderBlock(selectedTFBearishZoneTime, selectedTFBearishZoneHigh, selectedTFBearishZoneLow, bearishOrderBlockColor, "Supply OB • " + orderBlockTimeframeLabel)

//====================================================================
//==================== CANDLE PATTERN LETTERS ========================
//====================================================================

groupCandlePatterns = "13 • OPTIONAL • PRICE ACTION — CANDLE PATTERNS"

showCandlePatterns = input.bool(false, "Show Candle Pattern Letters", group = groupCandlePatterns, tooltip = "Optional educational labels. They do not change the ML signal or trade plan. Hover a letter to see the full pattern name.")
showEngulfingPatterns = input.bool(true, "Engulfing", group = groupCandlePatterns, inline = "candleTypes", tooltip = "E = Bullish or Bearish Engulfing. The current body fully covers the previous candle's body.")
showDarkCloudPattern = input.bool(true, "Dark Cloud Cover", group = groupCandlePatterns, inline = "candleTypes", tooltip = "C = Dark Cloud Cover, a bearish two-candle reversal pattern.")
showInvertedHammerPattern = input.bool(true, "Inverted Hammer", group = groupCandlePatterns, inline = "candleTypes2", tooltip = "I = Inverted Hammer after price is below the slow EMA.")
showShootingStarPattern = input.bool(true, "Shooting Star", group = groupCandlePatterns, inline = "candleTypes2", tooltip = "S = Shooting Star after price is above the slow EMA.")
showMarubozuPattern = input.bool(true, "Marubozu", group = groupCandlePatterns, inline = "candleTypes2", tooltip = "M = a strong-bodied candle with very small wicks.")
longWickToBody = input.float(2.0, "Long Wick / Body", minval = 1.0, maxval = 10.0, step = 0.25, group = groupCandlePatterns, tooltip = "Minimum upper-wick-to-body ratio for Inverted Hammer and Shooting Star patterns.")
marubozuBodyPercent = input.float(90.0, "Marubozu Body %", minval = 70.0, maxval = 100.0, step = 1.0, group = groupCandlePatterns, tooltip = "Minimum percentage of a candle's range that must be body to qualify as a Marubozu.")
candlePatternOffsetATR = input.float(0.10, "Letter Offset (ATR)", minval = 0.01, maxval = 1.00, step = 0.01, group = groupCandlePatterns, tooltip = "Distance of the pattern letter above or below its candle, measured in ATR.")
maxCandlePatternLabels = input.int(50, "Historical Pattern Letters", minval = 10, maxval = 200, group = groupCandlePatterns, tooltip = "Maximum number of candle-pattern letters kept on the chart.")

var array<label> candlePatternLabels = array.new<label>()
float candlePatternAtr = ta.atr(14)
float candlePatternTrendEma = ta.ema(close, 21)

drawCandlePattern(bool bullishPattern, string patternLetter, string patternName) =>
    float labelOffset = nz(candlePatternAtr, high - low) * candlePatternOffsetATR
    float labelPrice = bullishPattern ? low - labelOffset : high + labelOffset
    color patternColor = bullishPattern ? color.lime : color.red
    label newPatternLabel = label.new(bar_index, labelPrice, patternLetter, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, color = color.new(color.white, 100), textcolor = patternColor, size = size.small, tooltip = patternName)
    array.push(candlePatternLabels, newPatternLabel)
    if array.size(candlePatternLabels) > maxCandlePatternLabels
        label.delete(array.shift(candlePatternLabels))

float patternRange = high - low
float patternBody = math.abs(close - open)
float patternUpperWick = high - math.max(open, close)
float patternLowerWick = math.min(open, close) - low
bool hasPatternBody = patternRange > syminfo.mintick and patternBody >= syminfo.mintick
bool longUpperWick = hasPatternBody and patternUpperWick >= patternBody * longWickToBody and patternLowerWick <= patternBody * 0.75

bool invertedHammer = longUpperWick and close < candlePatternTrendEma
bool shootingStar = longUpperWick and close > candlePatternTrendEma
bool bullishMarubozu = patternRange > syminfo.mintick and close > open and patternBody / patternRange * 100 >= marubozuBodyPercent
bool bearishMarubozu = patternRange > syminfo.mintick and close < open and patternBody / patternRange * 100 >= marubozuBodyPercent
bool bullishEngulfing = bar_index > 0 and close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
bool bearishEngulfing = bar_index > 0 and close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
bool darkCloudCover = bar_index > 0 and close[1] > open[1] and close < open and open > open[1] and close < (open[1] + close[1]) / 2 and close > open[1]

// One priority-selected annotation per confirmed candle keeps the chart legible.
if showCandlePatterns and barstate.isconfirmed
    if showDarkCloudPattern and darkCloudCover
        drawCandlePattern(false, "C", "Dark Cloud Cover")
    else if showEngulfingPatterns and bullishEngulfing
        drawCandlePattern(true, "E", "Bullish Engulfing")
    else if showEngulfingPatterns and bearishEngulfing
        drawCandlePattern(false, "E", "Bearish Engulfing")
    else if showInvertedHammerPattern and invertedHammer
        drawCandlePattern(true, "I", "Inverted Hammer")
    else if showShootingStarPattern and shootingStar
        drawCandlePattern(false, "S", "Shooting Star")
    else if showMarubozuPattern and bullishMarubozu
        drawCandlePattern(true, "M", "Bullish Marubozu")
    else if showMarubozuPattern and bearishMarubozu
        drawCandlePattern(false, "M", "Bearish Marubozu")

