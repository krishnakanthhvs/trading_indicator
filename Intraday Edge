groupSMCExtras = "12 • SMC — ZONES & LIQUIDITY"

showEqualLevels = input.bool(true, "Show Equal Highs / Lows", group = groupSMCExtras, tooltip = "Marks two confirmed swing highs or lows that are close enough to form an equal-high (EQH) or equal-low (EQL) liquidity pool.")
equalLevelToleranceATR = input.float(0.10, "Equal-Level Tolerance (ATR)", minval = 0.01, maxval = 1.00, step = 0.01, group = groupSMCExtras, tooltip = "How close two confirmed swing levels must be, measured in ATR, to qualify as equal highs or lows.")
maxEqualLevels = input.int(10, "Historical Equal Levels", minval = 1, maxval = 100, group = groupSMCExtras, tooltip = "Maximum number of EQH and EQL annotations retained on the chart.")
eqhColor = input.color(color.fuchsia, "Equal High", group = groupSMCExtras, inline = "equalColors")
