groupTradePlan = "14 • SIGNAL TRADE PLAN"
showSignalTradePlan = input.bool(true, "Show Entry / SL / Targets", group = groupTradePlan, tooltip = "Creates one trade plan from the latest confirmed SB, B, BI, SS, S, or SI signal. Entry is the next candle's open; a new signal replaces the previous plan.")
tradePlanProjectionBars = input.int(24, "Line Length (Bars)", minval = 5, maxval = 200, group = groupTradePlan, tooltip = "How many chart bars the Entry, SL, and target lines extend. This prevents a completed plan from running across future sessions.")
tradePlanLineStyle = input.string("Solid", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = groupTradePlan, tooltip = "Visual style used for the Entry, Stop Loss, and target lines.")
showTradePlanTargetTicks = input.bool(true, "Mark Reached Targets", group = groupTradePlan, tooltip = "Adds a check mark beside a reached target label and changes that label to grey.")
removeCompletedTradePlan = input.bool(true, "Remove Plan After All Targets", group = groupTradePlan, tooltip = "Removes the Entry, Stop Loss, and all target lines and labels as soon as TP1, TP2, and TP3 have all been reached. This keeps the chart clear for the next signal.")
removeStoppedTradePlan = input.bool(true, "Remove Plan If Stop Loss Hits", group = groupTradePlan, tooltip = "Removes the complete plan immediately when its Stop Loss is reached. If one candle reaches both a target and the stop, Stop Loss takes priority because the intrabar order is unknown.")
tradePlanStopBufferATR = input.float(0.25, "Stop Buffer (ATR)", minval = 0.0, maxval = 5.0, step = 0.05, group = groupTradePlan, tooltip = "Extra distance beyond the signal candle's high or low. This helps prevent a stop being placed exactly at an obvious swing point.")
tradePlanTarget1R = input.float(1.0, "Target 1 (R)", minval = 0.25, maxval = 10.0, step = 0.25, group = groupTradePlan, inline = "tradeTargets", tooltip = "First target as a multiple of the entry-to-stop distance.")
tradePlanTarget2R = input.float(2.0, "Target 2 (R)", minval = 0.25, maxval = 20.0, step = 0.25, group = groupTradePlan, inline = "tradeTargets", tooltip = "Second target as a multiple of the entry-to-stop distance.")
tradePlanTarget3R = input.float(3.0, "Target 3 (R)", minval = 0.25, maxval = 30.0, step = 0.25, group = groupTradePlan, inline = "tradeTargets", tooltip = "Final target as a multiple of the entry-to-stop distance.")
float tradePlanAtr = ta.atr(14)

tradePlanLineStyleValue = switch tradePlanLineStyle
    "Dashed" => line.style_dashed
    "Dotted" => line.style_dotted
    => line.style_solid

var line tradePlanEntryLine = na
var line tradePlanStopLine = na
var line tradePlanTarget1Line = na
var line tradePlanTarget2Line = na
var line tradePlanTarget3Line = na
var label tradePlanEntryLabel = na
var label tradePlanStopLabel = na
var label tradePlanTarget1Label = na
var label tradePlanTarget2Label = na
var label tradePlanTarget3Label = na
var int tradePlanEndBar = na
var int tradePlanDirection = 0
var float tradePlanStopPrice = na
var float tradePlanTarget1Price = na
var float tradePlanTarget2Price = na
var float tradePlanTarget3Price = na
