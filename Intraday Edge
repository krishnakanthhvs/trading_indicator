bosBullColor = input.color(color.lime, "Bullish BOS", group = groupSMC, inline = "bosColors")
bosBearColor = input.color(color.red, "Bearish BOS", group = groupSMC, inline = "bosColors")
chochBullColor = input.color(color.aqua, "Bullish CHoCH", group = groupSMC, inline = "chochColors")
