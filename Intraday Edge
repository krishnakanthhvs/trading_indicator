showOrderBlocks = input.bool(true, "Show Order-Block Zones", group = groupSMCExtras, tooltip = "Draws a supply or demand zone from the most recent opposing candle before a confirmed BOS or CHoCH. These are simplified order blocks, not a guarantee of a reaction.")
orderBlockTimeframeInput = input.string("Chart", "Order-Block Source Timeframe", options = ["Chart", "3 minutes", "5 minutes", "15 minutes", "1 hour", "4 hours", "1 day", "1 week", "1 month"], group = groupSMCExtras, tooltip = "Displays order blocks detected on this timeframe. For reliable results, select a timeframe equal to or higher than the chart timeframe.")
maxOrderBlocks = input.int(8, "Historical Order Blocks", minval = 1, maxval = 40, group = groupSMCExtras, tooltip = "Maximum number of supply and demand zones retained on the chart.")
showBullishOrderBlocks = input.bool(true, "Demand Zones", group = groupSMCExtras, inline = "orderBlockTypes")
showBearishOrderBlocks = input.bool(true, "Supply Zones", group = groupSMCExtras, inline = "orderBlockTypes")
bullishOrderBlockColor = input.color(color.teal, "Demand OB", group = groupSMCExtras, inline = "orderBlockColors")
bearishOrderBlockColor = input.color(color.red, "Supply OB", group = groupSMCExtras, inline = "orderBlockColors")

string orderBlockTimeframe = switch orderBlockTimeframeInput
    "3 minutes" => "3"
    "5 minutes" => "5"
    "15 minutes" => "15"
    "1 hour" => "60"
