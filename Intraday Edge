markTradePlanTargetReached(label targetLabel, string targetName, float targetPrice) =>
    label.set_text(targetLabel, targetName + " ✓ (" + str.tostring(targetPrice, format.mintick) + ")")
    label.set_color(targetLabel, color.gray)
    label.set_textcolor(targetLabel, color.white)

deleteTradePlanGraphics() =>
    line.delete(tradePlanEntryLine)
    line.delete(tradePlanStopLine)
    line.delete(tradePlanTarget1Line)
    line.delete(tradePlanTarget2Line)
    line.delete(tradePlanTarget3Line)
    label.delete(tradePlanEntryLabel)
    label.delete(tradePlanStopLabel)
    label.delete(tradePlanTarget1Label)
    label.delete(tradePlanTarget2Label)
    label.delete(tradePlanTarget3Label)

bool nextCandleLongPlan = startLongTrade[1]
bool nextCandleShortPlan = startShortTrade[1]
bool isNewTradePlanSignal = (nextCandleLongPlan or nextCandleShortPlan) and (na(tradePlanSignalBar) or tradePlanSignalBar != bar_index - 1)

if showSignalTradePlan and isNewTradePlanSignal
    deleteTradePlanGraphics()
    tradePlanDirection := 0
    tradePlanStopPrice := na
    tradePlanTarget1Price := na
    tradePlanTarget2Price := na
    tradePlanTarget3Price := na
    tradePlanTarget1Hit := false
    tradePlanTarget2Hit := false
    tradePlanTarget3Hit := false
    tradePlanSignalBar := bar_index - 1

    float planEntry = open
    float planAtr = nz(tradePlanAtr[1], tradePlanAtr)
    float planStop = nextCandleLongPlan ? low[1] - planAtr * tradePlanStopBufferATR : high[1] + planAtr * tradePlanStopBufferATR
    float planRisk = nextCandleLongPlan ? planEntry - planStop : planStop - planEntry

    // A gap through the proposed stop invalidates the plan rather than drawing
    // a misleading negative-risk target structure.
    if planRisk > syminfo.mintick
        float planTarget1 = nextCandleLongPlan ? planEntry + planRisk * tradePlanTarget1R : planEntry - planRisk * tradePlanTarget1R
        float planTarget2 = nextCandleLongPlan ? planEntry + planRisk * tradePlanTarget2R : planEntry - planRisk * tradePlanTarget2R
        float planTarget3 = nextCandleLongPlan ? planEntry + planRisk * tradePlanTarget3R : planEntry - planRisk * tradePlanTarget3R
        tradePlanEndBar := bar_index + tradePlanProjectionBars
        tradePlanDirection := nextCandleLongPlan ? 1 : -1
        tradePlanStopPrice := planStop
        tradePlanTarget1Price := planTarget1
        tradePlanTarget2Price := planTarget2
        tradePlanTarget3Price := planTarget3

        tradePlanEntryLine := line.new(bar_index, planEntry, tradePlanEndBar, planEntry, xloc = xloc.bar_index, extend = extend.none, color = color.blue, width = 2, style = tradePlanLineStyleValue)
        tradePlanStopLine := line.new(bar_index, planStop, tradePlanEndBar, planStop, xloc = xloc.bar_index, extend = extend.none, color = color.red, width = 2, style = tradePlanLineStyleValue)
        tradePlanTarget1Line := line.new(bar_index, planTarget1, tradePlanEndBar, planTarget1, xloc = xloc.bar_index, extend = extend.none, color = color.lime, width = 1, style = tradePlanLineStyleValue)
        tradePlanTarget2Line := line.new(bar_index, planTarget2, tradePlanEndBar, planTarget2, xloc = xloc.bar_index, extend = extend.none, color = color.teal, width = 1, style = tradePlanLineStyleValue)
        tradePlanTarget3Line := line.new(bar_index, planTarget3, tradePlanEndBar, planTarget3, xloc = xloc.bar_index, extend = extend.none, color = color.green, width = 1, style = tradePlanLineStyleValue)

        tradePlanEntryLabel := label.new(tradePlanEndBar, planEntry, "ENTRY (" + str.tostring(planEntry, format.mintick) + ")", xloc = xloc.bar_index, style = label.style_label_left, color = color.blue, textcolor = color.white, size = size.small, tooltip = "Entry at the next candle's open after the confirmed signal.")
        tradePlanStopLabel := label.new(tradePlanEndBar, planStop, "SL (" + str.tostring(planStop, format.mintick) + ")", xloc = xloc.bar_index, style = label.style_label_left, color = color.red, textcolor = color.white, size = size.small, tooltip = "Stop beyond the signal candle, plus the selected ATR buffer.")
        tradePlanTarget1Label := label.new(tradePlanEndBar, planTarget1, "TP1 (" + str.tostring(planTarget1, format.mintick) + ")", xloc = xloc.bar_index, style = label.style_label_left, color = color.lime, textcolor = color.white, size = size.small, tooltip = "Target 1: " + str.tostring(tradePlanTarget1R) + "R.")
        tradePlanTarget2Label := label.new(tradePlanEndBar, planTarget2, "TP2 (" + str.tostring(planTarget2, format.mintick) + ")", xloc = xloc.bar_index, style = label.style_label_left, color = color.teal, textcolor = color.white, size = size.small, tooltip = "Target 2: " + str.tostring(tradePlanTarget2R) + "R.")
        tradePlanTarget3Label := label.new(tradePlanEndBar, planTarget3, "TP3 (" + str.tostring(planTarget3, format.mintick) + ")", xloc = xloc.bar_index, style = label.style_label_left, color = color.green, textcolor = color.white, size = size.small, tooltip = "Target 3: " + str.tostring(tradePlanTarget3R) + "R.")

if showSignalTradePlan and tradePlanDirection != 0
    bool stopLossReached = tradePlanDirection == 1 ? low <= tradePlanStopPrice : high >= tradePlanStopPrice
    bool target1Reached = tradePlanDirection == 1 ? high >= tradePlanTarget1Price : low <= tradePlanTarget1Price
    bool target2Reached = tradePlanDirection == 1 ? high >= tradePlanTarget2Price : low <= tradePlanTarget2Price
    bool target3Reached = tradePlanDirection == 1 ? high >= tradePlanTarget3Price : low <= tradePlanTarget3Price
    if removeStoppedTradePlan and stopLossReached
        deleteTradePlanGraphics()
        tradePlanDirection := 0
        tradePlanStopPrice := na
        tradePlanTarget1Price := na
        tradePlanTarget2Price := na
        tradePlanTarget3Price := na
    else
        if not tradePlanTarget1Hit and target1Reached
            tradePlanTarget1Hit := true
            if showTradePlanTargetTicks
                markTradePlanTargetReached(tradePlanTarget1Label, "TP1", tradePlanTarget1Price)
        if not tradePlanTarget2Hit and target2Reached
            tradePlanTarget2Hit := true
            if showTradePlanTargetTicks
                markTradePlanTargetReached(tradePlanTarget2Label, "TP2", tradePlanTarget2Price)
