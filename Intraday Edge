groupManualSR = "15 • MANUAL LEVELS"
showManualSR = input.bool(true, "Enable Manual Levels", group = groupManualSR, tooltip = "Shows your closest manual levels above and below price. A level above price is labelled Resistance; after price moves above it, the same level automatically becomes Support.")
manualLevelValues = input.text_area("18840.00, 21281.70, 21500.00, 21743.60\n21967.30, 22182.00, 22467.10, 22662.40\n22952.35, 23359.30, 23555.00, 23867.25\n24221.30, 24337.50, 24464.75, 24576.80\n24702.65, 25027.85, 25120.75, 25389.25\n25486.40, 25640.85, 25794.90, 26030.00\n26136.10, 26213.05, 26301.15, 26373.10", "Manual Levels", group = groupManualSR, tooltip = "All levels from your Nifty screenshot are preloaded in one list. Use one level per line or separate values with commas. The indicator decides whether each nearby level is Support or Resistance from the current price, so you never need to move a value between boxes. Do not use thousand separators: enter 24000, not 24,000.")
manualLevelsPerSide = input.int(2, "Nearest Levels Per Side", minval = 1, maxval = 5, group = groupManualSR, tooltip = "Shows this many nearest levels below price as Support and above price as Resistance. Default: two Supports and two Resistances.")
manualMoveToNextSession = input.bool(true, "Move to Next Session at Close", group = groupManualSR, tooltip = "Shows manual levels for the active market session only. After the session closes, they move to the following session, where Support and Resistance are recalculated from price.")
manualSupportColor = input.color(color.lime, "Support Color", group = groupManualSR, inline = "manualColors")
manualResistanceColor = input.color(color.red, "Resistance Color", group = groupManualSR, inline = "manualColors")
manualSRLineStyleInput = input.string("Dashed", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = groupManualSR)
manualSRLineWidth = input.int(1, "Line Width", minval = 1, maxval = 5, group = groupManualSR)

manualSRLineStyle = switch manualSRLineStyleInput
    "Solid" => line.style_solid
    "Dotted" => line.style_dotted
    => line.style_dashed

var array<line> manualSRLines = array.new<line>()
var array<label> manualSRLabels = array.new<label>()

parseManualPriceList(string priceList) =>
    array<float> parsedPrices = array.new_float()
    string commaSeparatedList = str.replace_all(str.replace_all(priceList, "\n", ","), "\r", ",")
    array<string> priceParts = str.split(commaSeparatedList, ",")
    for pricePart in priceParts
        float parsedPrice = str.tonumber(str.trim(pricePart))
        if not na(parsedPrice)
            parsedPrices.push(parsedPrice)
    parsedPrices

clearManualSRGraphics() =>
    for manualLine in manualSRLines
        line.delete(manualLine)
    for manualLabel in manualSRLabels
        label.delete(manualLabel)
    array.clear(manualSRLines)
    array.clear(manualSRLabels)

drawManualSRLevel(float levelPrice, bool isResistance) =>
    color levelColor = isResistance ? manualResistanceColor : manualSupportColor
    string levelName = isResistance ? "MR" : "MS"
    bool moveToFollowingSession = manualMoveToNextSession and not isCryptoOpenPointSession and marketSessionClosed
    int levelStartTime = moveToFollowingSession ? nextTradingSessionStart : sessionStart
    int levelEndTime = moveToFollowingSession ? nextTradingSessionEnd : sessionEnd
    line newManualLine = line.new(levelStartTime, levelPrice, levelEndTime, levelPrice, xloc = xloc.bar_time, color = levelColor, style = manualSRLineStyle, width = manualSRLineWidth)
    label newManualLabel = label.new(levelEndTime, levelPrice, levelName + " (" + str.tostring(levelPrice, format.mintick) + ")", xloc = xloc.bar_time, style = label.style_label_left, color = levelColor, textcolor = color.white, size = size.small)
    manualSRLines.push(newManualLine)
    manualSRLabels.push(newManualLabel)

drawNearestManualLevels(array<float> levelPrices, bool isResistance) =>
    array<float> displayedPrices = array.new_float()
    for selection = 0 to manualLevelsPerSide - 1
        float nearestPrice = na
        float nearestDistance = 1e20
        for levelPrice in levelPrices
            float distanceFromPrice = isResistance ? levelPrice - close : close - levelPrice
            // A level exactly at price is treated as resistance until price
            // closes above it, preventing the same manual level showing twice.
            bool isOnCorrectSide = isResistance ? distanceFromPrice >= 0 : distanceFromPrice > 0
            if isOnCorrectSide and not array.includes(displayedPrices, levelPrice) and distanceFromPrice < nearestDistance
                nearestPrice := levelPrice
                nearestDistance := distanceFromPrice
        if not na(nearestPrice)
            drawManualSRLevel(nearestPrice, isResistance)
            displayedPrices.push(nearestPrice)

// These drawings are rebuilt only on the latest bar. This keeps the feature
// responsive in live markets without populating every historical level. The
// visible levels span whole sessions rather than starting near the candle.
if barstate.islast
    clearManualSRGraphics()
    if showManualSR
        array<float> manualLevels = parseManualPriceList(manualLevelValues)
        drawNearestManualLevels(manualLevels, false)
        drawNearestManualLevels(manualLevels, true)

