type graphicSettings
    string levelName
    color levelColor
    bool showLevel

type pivotGraphic
    line pivotLine
    label pivotLabel

var array<graphicSettings> graphicSettingsArray = array.from(
    graphicSettings.new(" P", pColorInput, pShowInput),
    graphicSettings.new("R1", r1ColorInput, r1ShowInput), graphicSettings.new("S1", s1ColorInput, s1ShowInput),
    graphicSettings.new("R2", r2ColorInput, r2ShowInput), graphicSettings.new("S2", s2ColorInput, s2ShowInput),
    graphicSettings.new("R3", r3ColorInput, r3ShowInput), graphicSettings.new("S3", s3ColorInput, s3ShowInput),
    graphicSettings.new("R4", r4ColorInput, r4ShowInput), graphicSettings.new("S4", s4ColorInput, s4ShowInput),
    graphicSettings.new("R5", r5ColorInput, r5ShowInput), graphicSettings.new("S5", s5ColorInput, s5ShowInput)
)

var string autoAnchor = switch
    timeframe.isintraday => timeframe.multiplier <= 15 ? isDailyBasedInput ? "1D" : "1440" : "1W"
    timeframe.isdaily => "1M"
    => "12M"

var string pivotTimeframe = switch pivotAnchorInput
    "Auto" => autoAnchor
    "Daily" => isDailyBasedInput ? "1D" : "1440"
    "Weekly" => "1W"
    "Monthly" => "1M"
    "Quarterly" => "3M"
    => "12M"

var int pivotYearMultiplier = switch pivotAnchorInput
    "Biyearly" => 2
    "Triyearly" => 3
    "Quinquennially" => 5
    "Decennially" => 10
    => 1

var matrix<pivotGraphic> drawnGraphics = matrix.new<pivotGraphic>()

pivotTimeframeChangeCounter(bool condition) =>
    var int count = 0
    if condition and bar_index > 0
        count += 1
    count

method delete(pivotGraphic graphic) =>
    graphic.pivotLine.delete()
    graphic.pivotLabel.delete()

calculatePivots(simple bool isDailyBased) =>
    if isDailyBased
        bool pivotTimeframeChange = timeframe.change(timeframe.period) and year(time_tradingday, syminfo.timezone) % pivotYearMultiplier == 0
        [pivotPointsArrayStatic, pivotPointsArrayDeveloping, pivotCounter] = request.security(
            ticker.modify(syminfo.tickerid, settlement_as_close = settlement_as_close.on),
            pivotTimeframe,
            [
                ta.pivot_point_levels(pivotTypeInput, pivotTimeframeChange),
                ta.pivot_point_levels(pivotTypeInput, pivotTimeframeChange, developing = pivotTypeInput != "Woodie"),
                pivotTimeframeChangeCounter(pivotTimeframeChange)
            ],
            lookahead = barmerge.lookahead_on
        )
    else
        bool pivotTimeframeChange = timeframe.change(pivotTimeframe) and year(time_tradingday, syminfo.timezone) % pivotYearMultiplier == 0
        array<float> pivotPointsArrayStatic = ta.pivot_point_levels(pivotTypeInput, pivotTimeframeChange)
        array<float> pivotPointsArrayDeveloping = ta.pivot_point_levels(pivotTypeInput, pivotTimeframeChange, developing = pivotTypeInput != "Woodie")
        int pivotCounter = pivotTimeframeChangeCounter(pivotTimeframeChange)
        [pivotPointsArrayStatic, pivotPointsArrayDeveloping, pivotCounter]

affixOldPivots(int endTime) =>
    int rows = drawnGraphics.rows()
    if rows > 0
        array<pivotGraphic> lastGraphics = drawnGraphics.row(rows - 1)
        for graphic in lastGraphics
            graphic.pivotLine.set_x2(endTime)
            if positionLabelsInput == "Right"
                graphic.pivotLabel.set_x(endTime)

drawNewPivots(int startTime, array<float> pivotPointsArray) =>
    array<pivotGraphic> newGraphics = array.new<pivotGraphic>()
    int endTime = startTime + timeframe.in_seconds(pivotTimeframe) * 1000 * pivotYearMultiplier
    [labelPosition, labelStyle] = switch positionLabelsInput
        "Left" => [startTime, label.style_label_right]
        "Right" => [endTime, label.style_label_left]
    for [index, level] in pivotPointsArray
        graphicSettings levelSettings = graphicSettingsArray.get(index)
        if showPivotPoints and not na(level) and levelSettings.showLevel
            line pivotLine = line.new(startTime, level, endTime, level, xloc = xloc.bar_time, color = levelSettings.levelColor, width = linewidthInput)
            label pivotLabel = label.new(
                labelPosition,
                level,
                (showLabelsInput ? levelSettings.levelName + " " : "") + (showPricesInput ? "(" + str.tostring(level, format.mintick) + ")" : ""),
                style = labelStyle,
                textcolor = color.black,
                color = levelSettings.levelColor,
                size = size.small,
                xloc = xloc.bar_time
            )
            newGraphics.push(pivotGraphic.new(pivotLine, pivotLabel))
    if newGraphics.size() > 0
        drawnGraphics.add_row(array_id = newGraphics)
        if drawnGraphics.rows() > maxHistoricalPivotsInput
            array<pivotGraphic> oldGraphics = drawnGraphics.remove_row(0)
            for graphic in oldGraphics
                graphic.delete()

[pivotPointsArrayStatic, pivotPointsArrayDeveloping, pivotCount] = calculatePivots(isDailyBasedInput)
float pivot = array.size(pivotPointsArrayStatic) > 0 ? array.get(pivotPointsArrayStatic, 0) : na

var bool skipNextPivots = false
if barstate.islast and barstate.isconfirmed and pivotTypeInput != "Woodie"
    int nextBarOpenTime = time("", bars_back = -1)
    int nextPivotStartTime = time(pivotTimeframe, timeframe_bars_back = -1)
    if nextBarOpenTime >= nextPivotStartTime
        affixOldPivots(nextPivotStartTime)
        drawNewPivots(nextPivotStartTime, pivotPointsArrayDeveloping)
        skipNextPivots := true
if pivotCount != pivotCount[1]
    if skipNextPivots
        skipNextPivots := false
    else
        affixOldPivots(time)
        drawNewPivots(time, pivotPointsArrayStatic)
else if drawnGraphics.rows() > 0 and drawnGraphics.row(drawnGraphics.rows() - 1).last().pivotLine.get_x2() <= time[1]
    affixOldPivots(time)

var int firstBarTime = time
if barstate.islastconfirmedhistory and drawnGraphics.rows() == 0
    if pivotCount > 0 and not na(pivotPointsArrayStatic)
        drawNewPivots(firstBarTime, pivotPointsArrayStatic)
    else if timeframe.isintraday and not isDailyBasedInput
        runtime.error("Not enough intraday data available for pivot point calculation. Select a lower timeframe from the options in the 'Pivots timeframe' input, or try selecting the 'Use daily-based values' checkbox to request EOD data.")
    else
        runtime.error("Not enough data available for pivot point calculation. Select a lower timeframe from the options in the 'Pivots timeframe' input.")

var line dailyOpenLine = na
var line weeklyOpenLine = na

var label dailyOpenLbl = na
var label weeklyOpenLbl = na

//====================================================================
//====================== OPEN PRICES =================================
//====================================================================

var float dailyOpen = na

// Resolve the Open Point session from the selected profile. In Auto mode, MCX
// Energy/Metal contracts (including Crude Oil) receive the 09:00-23:30
// session used during the US daylight-saving season.
string autoOpenPointSession = syminfo.type == "crypto" ? "Crypto (24/7)" : syminfo.prefix == "MCX" ? "Commodities (09:00-23:30)" : "Indices / Equity (09:15-15:30)"
string activeOpenPointSession = openPointSessionProfile == "Auto" ? autoOpenPointSession : openPointSessionProfile

bool isCryptoOpenPointSession = activeOpenPointSession == "Crypto (24/7)"
bool isCommodityOpenPointSession = activeOpenPointSession == "Commodities (09:00-23:30)"
bool isCommodityWinterSession = activeOpenPointSession == "Commodities Winter (09:00-23:55)"
bool isMCXInternationalAgriSession = activeOpenPointSession == "MCX International Agri (09:00-21:00)"
bool isMCXDomesticAgriSession = activeOpenPointSession == "MCX Domestic Agri (09:00-17:00)"
bool isMCXSession = isCommodityOpenPointSession or isCommodityWinterSession or isMCXInternationalAgriSession or isMCXDomesticAgriSession
bool isCustomOpenPointSession = activeOpenPointSession == "Custom"

int openPointStartHour = isCryptoOpenPointSession ? 0 : isMCXSession ? 9 : isCustomOpenPointSession ? customOpenStartHour : 9
int openPointStartMinute = isCryptoOpenPointSession or isMCXSession ? 0 : isCustomOpenPointSession ? customOpenStartMinute : 15
int openPointEndHour = isCryptoOpenPointSession ? 0 : isCommodityOpenPointSession or isCommodityWinterSession ? 23 : isMCXInternationalAgriSession ? 21 : isMCXDomesticAgriSession ? 17 : isCustomOpenPointSession ? customOpenEndHour : 15
int openPointEndMinute = isCryptoOpenPointSession ? 0 : isCommodityOpenPointSession ? 30 : isCommodityWinterSession ? 55 : isMCXInternationalAgriSession or isMCXDomesticAgriSession ? 0 : isCustomOpenPointSession ? customOpenEndMinute : 30
bool openPointEndsNextDay = isCryptoOpenPointSession or (isCustomOpenPointSession and (openPointEndHour < openPointStartHour or (openPointEndHour == openPointStartHour and openPointEndMinute <= openPointStartMinute)))

int sessionStart = timestamp(syminfo.timezone, year, month, dayofmonth, openPointStartHour, openPointStartMinute)
int sessionEnd = timeframe.isintraday ? timestamp(syminfo.timezone, year, month, dayofmonth + (openPointEndsNextDay ? 1 : 0), openPointEndHour, openPointEndMinute) : time + 7 * 24 * 60 * 60 * 1000
// Use the chart's next actual trading day rather than adding 24 hours. This
// skips weekends and exchange holidays when rolling session-based drawings.
int nextTradingDayTime = time("D", timeframe_bars_back = -1)
int nextTradingSessionStart = not na(nextTradingDayTime) ? timestamp(syminfo.timezone, year(nextTradingDayTime, syminfo.timezone), month(nextTradingDayTime, syminfo.timezone), dayofmonth(nextTradingDayTime, syminfo.timezone), openPointStartHour, openPointStartMinute) : sessionStart + 24 * 60 * 60 * 1000
int nextTradingSessionEnd = not na(nextTradingDayTime) ? timestamp(syminfo.timezone, year(nextTradingDayTime, syminfo.timezone), month(nextTradingDayTime, syminfo.timezone), dayofmonth(nextTradingDayTime, syminfo.timezone) + (openPointEndsNextDay ? 1 : 0), openPointEndHour, openPointEndMinute) : sessionEnd + 24 * 60 * 60 * 1000
bool isInOpenPointSession = isCryptoOpenPointSession or (time >= sessionStart and time < sessionEnd)
bool isNewOpenPointSession = isInOpenPointSession and (na(time[1]) or time[1] < sessionStart or time[1] >= sessionEnd)

if isNewOpenPointSession
    dailyOpen := open
else
    dailyOpen := nz(dailyOpen[1])

// The Open Point is an immediate directional reference: green above it, red
// below it, and the selected neutral colour only when price equals the open.
dailyOpenLineColor =
     close > dailyOpen ? openBullColor :
     close < dailyOpen ? openBearColor :
     dailyOpenColor

weeklyOpen = request.security(
     syminfo.tickerid,
     "W",
     open,
     lookahead = barmerge.lookahead_on)

weeklyOpenLineColor =
     close >= weeklyOpen + openBullThreshold ? openBullColor :
     close <= weeklyOpen - openBearThreshold ? openBearColor :
     openNeutralColor

//====================================================
// Draw non-pivot session levels
//====================================================

bool newSession = isNewOpenPointSession
// Crypto session levels are useful only on lower intraday timeframes. Hide
// them from 30-minute and higher crypto charts while retaining them for all
// intraday timeframes on the other market profiles.
bool isCryptoBelowThirtyMinutes = timeframe.isseconds or (timeframe.isminutes and timeframe.multiplier < 30)
bool showIntradaySessionLevels = timeframe.isintraday and (not isCryptoOpenPointSession or isCryptoBelowThirtyMinutes)
// MCX Open Point is an intraday reference. On 30-minute and higher charts it
// is more misleading than useful, so keep the ORB available but suppress Open
// Point.
bool isCommodityInstrument = syminfo.prefix == "MCX" or isMCXSession
bool hideCommodityOpenPoint = isCommodityInstrument and timeframe.in_seconds() >= timeframe.in_seconds("30")
// The daily Open Point is valid only during the selected cash/commodity
// session. Unlike pivots and ORB, it must not remain after that market closes.
// On a normal chart there is no bar after the final session candle. timenow
// lets the last bar clear session-only levels once the actual market close has
// passed, while extended-hours bars are covered by the time-range test.
bool marketSessionClosed = not isCryptoOpenPointSession and (time >= sessionEnd or (barstate.islast and timenow >= sessionEnd))
bool openPointSessionActive = isInOpenPointSession and not marketSessionClosed
bool showDailyOpenForChart = showDailyOpen and not hideCommodityOpenPoint and openPointSessionActive
int openPointEndTime = sessionEnd
bool showSessionOnlyLevels = showIntradaySessionLevels and openPointSessionActive
int sessionOnlyLevelEndTime = sessionEnd
if newSession
    line.delete(dailyOpenLine)
    line.delete(weeklyOpenLine)
    label.delete(dailyOpenLbl)
    label.delete(weeklyOpenLbl)

    if showIntradaySessionLevels and showDailyOpenForChart
        dailyOpenLine := line.new(x1 = sessionStart, y1 = dailyOpen, x2 = openPointEndTime, y2 = dailyOpen, xloc = xloc.bar_time, color = dailyOpenColor, width = openLineWidth)
    if showSessionOnlyLevels and showWeeklyOpen
        weeklyOpenLine := line.new(x1 = sessionStart, y1 = weeklyOpen, x2 = sessionOnlyLevelEndTime, y2 = weeklyOpen, xloc = xloc.bar_time, color = weeklyOpenLineColor, width = openLineWidth)

    if showIntradaySessionLevels and showOpenLabels
        if showDailyOpenForChart
            dailyOpenLbl := label.new(openPointEndTime, dailyOpen, showOpenValues ? "Open Point (" + str.tostring(dailyOpen, format.mintick) + ")" : "DO", xloc = xloc.bar_time, style = label.style_label_left, color = dailyOpenLineColor, textcolor = color.black, size = size.small)
        if showSessionOnlyLevels and showWeeklyOpen
            weeklyOpenLbl := label.new(sessionOnlyLevelEndTime, weeklyOpen, showOpenValues ? "Weekly OP (" + str.tostring(weeklyOpen, format.mintick) + ")" : "WO", xloc = xloc.bar_time, style = label.style_label_left, color = weeklyOpenLineColor, textcolor = color.white, size = size.small)

// Keep Open Point colours current even when the user hides its labels.
if showSessionOnlyLevels
    if showDailyOpenForChart and not na(dailyOpenLine)
        line.set_color(dailyOpenLine, dailyOpenLineColor)
        line.set_x2(dailyOpenLine, openPointEndTime)
    if showWeeklyOpen and not na(weeklyOpenLine)
        line.set_x2(weeklyOpenLine, sessionOnlyLevelEndTime)

if showSessionOnlyLevels and showOpenLabels
    if showDailyOpenForChart and not na(dailyOpenLbl)
        label.set_x(dailyOpenLbl, openPointEndTime)
        label.set_text(dailyOpenLbl, showOpenValues ? "Open Point (" + str.tostring(dailyOpen, format.mintick) + ")" : "DO")
        label.set_color(dailyOpenLbl, dailyOpenLineColor)
    if showWeeklyOpen and not na(weeklyOpenLbl)
        label.set_x(weeklyOpenLbl, sessionOnlyLevelEndTime)
        label.set_text(weeklyOpenLbl, showOpenValues ? "Weekly OP (" + str.tostring(weeklyOpen, format.mintick) + ")" : "WO")
        label.set_color(weeklyOpenLbl, weeklyOpenLineColor)

// Extended-hours data can produce bars after the configured close. Remove all
// session-only levels on those bars instead of leaving expired levels.
if not showSessionOnlyLevels
    line.delete(dailyOpenLine)
    line.delete(weeklyOpenLine)
    label.delete(dailyOpenLbl)
    label.delete(weeklyOpenLbl)
    dailyOpenLine := na
    weeklyOpenLine := na
    dailyOpenLbl := na
    weeklyOpenLbl := na

//====================================================================
//====================== ORB LEVELS ==================================
//====================================================================

groupORB = "09 • ORB LEVELS"

showORB = input.bool(true, "Enable ORB", group = groupORB)

orbTF = input.string(
     "5",
     "Opening Range Duration",
     options = ["1","3","5","10","15","30","60"],
     group = groupORB,
     tooltip = "Minutes included in the opening range. For an exact range, use a chart timeframe equal to or lower than this duration; a higher chart timeframe can only use that bar's full high and low.")

orbSkipCandles = input.int(
     0,
     "Skip First N Candles",
     minval = 0,
     maxval = 20,
     group = groupORB)

extendORB = input.bool(true, "Extend Through Session", group = groupORB, tooltip = "Keeps ORB high, low, and middle lines through the selected market session. All ORB levels are removed when that session closes. Turn this off to end the lines at the latest bar.")

showORBMid = input.bool(true, "Show Mid Line", group = groupORB)

showORBLabels = input.bool(true, "Show Labels", group = groupORB)

showORBValues = input.bool(true, "Show Values", group = groupORB)

orbHighColor = input.color(color.green, "High Color", group=groupORB)
orbLowColor  = input.color(color.red, "Low Color", group=groupORB)
orbMidColor  = input.color(color.orange, "Mid Color", group=groupORB)

orbWidth = input.int(2,"Line Width",1,5,group=groupORB)

orbLineStyle = input.string(
     "Dotted",
     "Style",
     options=["Solid","Dashed","Dotted"],
     group=groupORB)


//========================
// ORB Objects
//========================

var line orbHighLine = na
var line orbLowLine  = na
var line orbMidLine  = na

var label orbHighLbl = na
var label orbLowLbl  = na
var label orbMidLbl  = na

orbStyle =(
    orbLineStyle == "Dotted"  ? line.style_dotted :
    orbLineStyle == "Dashed" ? line.style_dashed :
                                line.style_solid
)

//====================================================================
//====================== ORB CALCULATION ==============================
//====================================================================

var float orbHigh = na
var float orbLow  = na
var float orbMid  = na
var int orbStartTime  = na

var bool orbLocked = false

// ORB must reset at the selected exchange-session opening rather than at the
// calendar-day boundary. This keeps commodity contracts aligned to their
// actual session, including a chart that begins after the nominal open.
bool isInOrbSession = timeframe.isintraday and time >= sessionStart and time < sessionEnd
bool newOrbSession = isInOrbSession and (na(time[1]) or time[1] < sessionStart or time[1] >= sessionEnd)

if newOrbSession
    line.delete(orbHighLine)
    line.delete(orbLowLine)
    line.delete(orbMidLine)
    label.delete(orbHighLbl)
    label.delete(orbLowLbl)
    label.delete(orbMidLbl)
    orbHighLine := na
    orbLowLine := na
    orbMidLine := na
    orbHighLbl := na
    orbLowLbl := na
    orbMidLbl := na
    orbLocked := false
    orbHigh := na
    orbLow := na
    orbMid := na
    orbStartTime := na

int orbSkipMilliseconds = orbSkipCandles * timeframe.in_seconds() * 1000
int orbCollectionStartTime = sessionStart + orbSkipMilliseconds
int orbCollectionEndTime = orbCollectionStartTime + timeframe.in_seconds(orbTF) * 1000
bool isCollectingORB = isInOrbSession and time >= orbCollectionStartTime and time < orbCollectionEndTime

// Build the high/low across the selected opening-range duration, then lock it
// once that window has ended. The prior code accepted an ORB timeframe input
// but always used one chart bar; this makes the selected duration operative.
if showIntradaySessionLevels and showORB and isCollectingORB and not orbLocked
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow := na(orbLow) ? low : math.min(orbLow, low)
    orbMid := (orbHigh + orbLow) / 2
    orbStartTime := orbCollectionStartTime

if showIntradaySessionLevels and showORB and isInOrbSession and not orbLocked and time >= orbCollectionEndTime and not na(orbHigh)
    orbLocked := true

int orbLevelEndTime = extendORB ? sessionEnd : time_close
bool createLevels = showIntradaySessionLevels and showORB and orbLocked and na(orbHighLine)

if createLevels
    line.delete(orbHighLine)
    line.delete(orbLowLine)
    line.delete(orbMidLine)

    label.delete(orbHighLbl)
    label.delete(orbLowLbl)
    label.delete(orbMidLbl)

    if orbLocked

        orbHighLine := line.new(x1=orbStartTime, y1=orbHigh, x2=orbLevelEndTime, y2=orbHigh, xloc=xloc.bar_time, color=orbHighColor, width=orbWidth, style=orbStyle)

        orbLowLine := line.new(x1=orbStartTime, y1=orbLow, x2=orbLevelEndTime, y2=orbLow, xloc=xloc.bar_time, color=orbLowColor, width=orbWidth, style=orbStyle)

    if showORBMid and orbLocked

        orbMidLine := line.new(x1=orbStartTime, y1=orbMid, x2=orbLevelEndTime, y2=orbMid, xloc=xloc.bar_time, color=orbMidColor, width=orbWidth, style=orbStyle)

    if showORBLabels and orbLocked

        orbHighLbl := label.new(orbLevelEndTime, orbHigh, showORBValues ? "ORB High (" + str.tostring(orbHigh) + ")" : "ORB High", xloc=xloc.bar_time, style=label.style_label_left, color=orbHighColor, textcolor=color.white, size=size.small)

        orbLowLbl := label.new(orbLevelEndTime, orbLow, showORBValues ? "ORB Low (" + str.tostring(orbLow) + ")" : "ORB Low", xloc=xloc.bar_time, style=label.style_label_left, color=orbLowColor, textcolor=color.white, size=size.small)

    if showORBMid and orbLocked

        orbMidLbl := label.new(orbLevelEndTime, orbMid, showORBValues ? "ORB Middle (" + str.tostring(orbMid) + ")" : "ORB Middle", xloc=xloc.bar_time, style=label.style_label_left, color=orbMidColor, textcolor=color.black, size=size.small)

if showSessionOnlyLevels and showORB and orbLocked

    if not na(orbHighLine)
        line.set_x2(orbHighLine, orbLevelEndTime)
    if not na(orbLowLine)
        line.set_x2(orbLowLine, orbLevelEndTime)
    if showORBMid and not na(orbMidLine)
        line.set_x2(orbMidLine, orbLevelEndTime)

    if showORBLabels

        if not na(orbHighLbl)
            label.set_x(orbHighLbl, orbLevelEndTime)
            label.set_text(orbHighLbl, showORBValues ? "ORB High (" + str.tostring(orbHigh) + ")" : "ORB High")

        if not na(orbLowLbl)
            label.set_x(orbLowLbl, orbLevelEndTime)
            label.set_text(orbLowLbl, showORBValues ? "ORB Low (" + str.tostring(orbLow) + ")" : "ORB Low")

        if showORBMid and not na(orbMidLbl)
            label.set_x(orbMidLbl, orbLevelEndTime)
            label.set_text(orbMidLbl, showORBValues ? "ORB Middle (" + str.tostring(orbMid) + ")" : "ORB Middle")

// ORB belongs only to the active market session. Remove it at the configured
// close, just like the Open Point and Weekly Open.
if not showSessionOnlyLevels
    line.delete(dailyOpenLine)
    line.delete(weeklyOpenLine)
    line.delete(orbHighLine)
    line.delete(orbLowLine)
    line.delete(orbMidLine)

    label.delete(dailyOpenLbl)
    label.delete(weeklyOpenLbl)
    label.delete(orbHighLbl)
    label.delete(orbLowLbl)
    label.delete(orbMidLbl)

    dailyOpenLine := na
    weeklyOpenLine := na
    orbHighLine := na
    orbLowLine := na
    orbMidLine := na

    dailyOpenLbl := na
    weeklyOpenLbl := na
    orbHighLbl := na
    orbLowLbl := na
    orbMidLbl := na
    orbHigh := na
    orbLow := na
    orbMid := na
    orbLocked := false

//====================================================================
//==================== LIQUIDITY SWEEP ================================
//====================================================================

groupLS = "10 • OPTIONAL • LIQUIDITY SWEEP"

showLS = input.bool(false, "Enable Liquidity Sweep", group=groupLS, tooltip="Optional visual confirmation. Sweeps are confirmed only after the swing is known, so they appear later than the actual turning point.")

lsSwing = input.int(
     7,
     "Confirmed Swing Length",
     minval=3,
     maxval=30,
     group=groupLS)

lsMinSweepATR = input.float(0.15, "Minimum Sweep Beyond Swing (ATR)", minval=0.05, step=0.05, group=groupLS)
lsMinVolumeMultiplier = input.float(1.20, "Minimum Volume Multiplier", minval=0.50, step=0.05, group=groupLS)
lsRejectionClosePercent = input.float(40.0, "Rejection Close Zone %", minval=10, maxval=50, step=5, group=groupLS, tooltip="A bearish sweep must close in the lower portion of its candle; a bullish sweep must close in the upper portion.")

showBullLS = input.bool(true, "Bullish LS", group=groupLS)
showBearLS = input.bool(true, "Bearish LS", group=groupLS)

lsColor = input.color(color.orange, "Sweep Marker", group=groupLS)

float ph = ta.pivothigh(high, lsSwing, lsSwing)
float pl = ta.pivotlow(low, lsSwing, lsSwing)

var float lastHigh = na
var float lastLow = na
var bool highLiquidityTaken = false
var bool lowLiquidityTaken = false

if not na(ph)
    lastHigh := ph
    highLiquidityTaken := false

if not na(pl)
    lastLow := pl
    lowLiquidityTaken := false

lsAtr = ta.atr(14)
lsAverageVolume = ta.sma(volume, 20)
lsCandleRange = high - low
bearishLSRejection = close < open and lsCandleRange > 0 and close <= low + lsCandleRange * lsRejectionClosePercent / 100
bullishLSRejection = close > open and lsCandleRange > 0 and close >= high - lsCandleRange * lsRejectionClosePercent / 100
lsVolumeConfirmed = volume >= lsAverageVolume * lsMinVolumeMultiplier

bearLS =
     showLS and
     showBearLS and
     not na(lastHigh) and
     not highLiquidityTaken and
     high > lastHigh + lsAtr * lsMinSweepATR and
     close < lastHigh and
     bearishLSRejection and
     lsVolumeConfirmed and
     barstate.isconfirmed

bullLS =
     showLS and
     showBullLS and
     not na(lastLow) and
     not lowLiquidityTaken and
     low < lastLow - lsAtr * lsMinSweepATR and
     close > lastLow and
     bullishLSRejection and
     lsVolumeConfirmed and
     barstate.isconfirmed

// A confirmed swing's liquidity can produce only one valid sweep signal.
if bearLS
    highLiquidityTaken := true

if bullLS
    lowLiquidityTaken := true

plotshape(
     bearLS,
     title="Bearish LS",
     text="LS",
     style=shape.triangledown,
     location=location.abovebar,
     color=lsColor,
     textcolor=color.blue,
     size=size.tiny)

plotshape(
     bullLS,
     title="Bullish LS",
     text="LS",
     style=shape.triangleup,
     location=location.belowbar,
     color=lsColor,
     textcolor=color.green,
     size=size.tiny)


